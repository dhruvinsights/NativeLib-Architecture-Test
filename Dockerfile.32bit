# Dockerfile for 32-bit JVM testing
# Uses multiarch Debian with 32-bit packages

FROM debian:bullseye-slim

# Enable i386 architecture
RUN dpkg --add-architecture i386 && \
    apt-get update && \
    apt-get install -y \
        openjdk-17-jdk:i386 \
        gcc-multilib \
        g++-multilib \
        libc6:i386 \
        libstdc++6:i386 \
        make \
        file && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Find and set JAVA_HOME for 32-bit JDK
RUN JAVA_HOME_32=$(find /usr/lib/jvm -name "java-17-openjdk-*" -type d | grep i386 | head -1) && \
    echo "export JAVA_HOME=$JAVA_HOME_32" >> /etc/profile && \
    echo "export PATH=\$JAVA_HOME/bin:\$PATH" >> /etc/profile

# Set working directory
WORKDIR /app

# Copy project files
COPY . .

# Build the project with 32-bit compilation
RUN chmod +x build.sh && \
    export JAVA_HOME=$(find /usr/lib/jvm -name "java-17-openjdk-*" -type d | grep i386 | head -1) && \
    export PATH=$JAVA_HOME/bin:$PATH && \
    ./build.sh

# Verify library is 32-bit
RUN file build/native-lib/lib/libnativemath.so

# Set library path
ENV LD_LIBRARY_PATH=/app/build/native-lib/lib:$LD_LIBRARY_PATH

# Run with 32-bit JVM loading 32-bit library (will SUCCEED)
CMD export JAVA_HOME=$(find /usr/lib/jvm -name "java-17-openjdk-*" -type d | grep i386 | head -1) && \
    export PATH=$JAVA_HOME/bin:$PATH && \
    java -version && \
    java -Djava.library.path=/app/build/native-lib/lib \
         -cp /app/dist/app-main.jar:/app/dist/service-lib.jar:/app/dist/native-lib.jar \
         com.example.app.MainApp