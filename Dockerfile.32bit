# Dockerfile for 32-bit JVM testing
# This uses i386 architecture to run 32-bit JVM with 32-bit native library

FROM i386/debian:bullseye-slim

# Install 32-bit JDK and build tools
RUN apt-get update && \
    apt-get install -y \
        openjdk-17-jdk \
        gcc \
        g++ \
        make \
        file && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Verify we're running 32-bit
RUN uname -m && file /bin/bash

# Set JAVA_HOME for 32-bit JDK
ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-i386
ENV PATH=$JAVA_HOME/bin:$PATH

# Set working directory
WORKDIR /app

# Copy project files
COPY . .

# Build the project - will compile 32-bit native library
RUN chmod +x build.sh && \
    ./build.sh

# Verify library is 32-bit
RUN file build/native-lib/lib/libnativemath.so

# Set library path
ENV LD_LIBRARY_PATH=/app/build/native-lib/lib:$LD_LIBRARY_PATH

# Run with 32-bit JVM loading 32-bit library (will SUCCEED)
CMD ["java", \
     "-Djava.library.path=/app/build/native-lib/lib", \
     "-cp", "/app/dist/app-main.jar:/app/dist/service-lib.jar:/app/dist/native-lib.jar", \
     "com.example.app.MainApp"]